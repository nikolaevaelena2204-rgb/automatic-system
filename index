<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>💌 Письмо для тебя</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --purple: #764ba2;
    --purple-light: #667eea;
    --green: #10b981;
    --red: #ef4444;
    --pink: #ec4899;
    --gold: #f59e0b;
  }

  body {
    font-family: 'Segoe UI', Tahoma, sans-serif;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #ec4899 100%);
    background-size: 200% 200%;
    animation: gradientShift 15s ease infinite;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    overflow: hidden;
    cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='28' height='28' viewBox='0 0 28 28'><text y='22' font-size='22'>💖</text></svg>") 14 14, auto;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .bg-heart {
    position: fixed;
    font-size: 24px;
    opacity: 0.15;
    animation: floatUp linear infinite;
    pointer-events: none;
    z-index: 0;
  }
  @keyframes floatUp {
    from { transform: translateY(110vh) rotate(0deg); }
    to { transform: translateY(-10vh) rotate(360deg); }
  }

  .star {
    position: fixed;
    top: -30px;
    font-size: 18px;
    pointer-events: none;
    z-index: 0;
    animation: starFall linear forwards;
    opacity: 0.6;
  }
  @keyframes starFall {
    to { transform: translateY(110vh) rotate(360deg); opacity: 0; }
  }

  .card {
    background: #fff;
    border-radius: 24px;
    padding: 40px;
    max-width: 560px;
    width: 100%;
    box-shadow: 0 25px 70px rgba(0,0,0,0.35);
    text-align: center;
    position: relative;
    z-index: 1;
    animation: cardIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    transition: box-shadow 0.3s;
  }

  .card:hover { box-shadow: 0 30px 80px rgba(118,75,162,0.4); }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  h1 {
    color: var(--purple);
    margin-bottom: 12px;
    font-size: 30px;
    letter-spacing: -0.5px;
  }

  p { color: #666; margin-bottom: 15px; line-height: 1.6; }

  textarea {
    width: 100%;
    min-height: 120px;
    padding: 16px;
    border: 2px solid #e5e5e5;
    border-radius: 14px;
    font-family: inherit;
    font-size: 16px;
    resize: vertical;
    margin-bottom: 8px;
    transition: all 0.3s;
    background: #fafafa;
  }

  textarea:focus {
    outline: none;
    border-color: var(--purple);
    background: #fff;
    box-shadow: 0 0 0 4px rgba(118,75,162,0.12);
  }

  .char-counter {
    text-align: right;
    font-size: 13px;
    color: #999;
    margin-bottom: 18px;
    transition: color 0.3s;
  }
  .char-counter.warn { color: var(--red); }

  /* ====== БЛОК ОТПРАВИТЕЛЯ ====== */

  .sender-section {
    background: #f8f7fc;
    border: 2px solid #ece9f5;
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 20px;
    text-align: left;
  }

  .sender-section .section-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--purple);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .sender-toggle {
    display: flex;
    gap: 10px;
    margin-bottom: 14px;
  }

  .sender-toggle button {
    flex: 1;
    padding: 11px 14px;
    font-size: 14px;
    border-radius: 10px;
    border: 2px solid #ddd;
    background: #fff;
    color: #555;
    cursor: pointer;
    transition: all 0.25s;
    font-weight: 600;
  }

  .sender-toggle button.active {
    border-color: var(--purple);
    background: linear-gradient(135deg, var(--purple-light), var(--purple));
    color: #fff;
    box-shadow: 0 4px 14px rgba(118,75,162,0.3);
    transform: translateY(-1px);
  }

  .sender-toggle button:not(.active):hover {
    border-color: var(--purple-light);
    background: #f4f2fb;
  }

  #nameInput {
    width: 100%;
    padding: 13px 16px;
    border: 2px solid #e5e5e5;
    border-radius: 10px;
    font-size: 15px;
    font-family: inherit;
    transition: all 0.3s;
    background: #fff;
  }

  #nameInput:focus {
    outline: none;
    border-color: var(--purple);
    box-shadow: 0 0 0 4px rgba(118,75,162,0.12);
  }

  #nameInput:disabled {
    background: #f0f0f0;
    color: #999;
    cursor: not-allowed;
  }

  .anon-hint {
    font-size: 13px;
    color: #888;
    margin-top: 8px;
    font-style: italic;
  }

  button.main-btn {
    background: linear-gradient(135deg, var(--purple-light) 0%, var(--purple) 100%);
    color: white;
    border: none;
    padding: 15px 32px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, opacity 0.2s;
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  button.main-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(118,75,162,0.4);
  }
  button.main-btn:active:not(:disabled) { transform: translateY(0); }
  button.main-btn:disabled { opacity: 0.5; cursor: not-allowed; }

  button .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.6);
    transform: scale(0);
    animation: rippleAnim 0.6s ease-out;
    pointer-events: none;
  }
  @keyframes rippleAnim {
    to { transform: scale(4); opacity: 0; }
  }

  .link-box {
    background: #f4f4f8;
    border-radius: 14px;
    padding: 20px;
    margin-top: 22px;
    font-size: 14px;
    color: #333;
    display: none;
    animation: fadeIn 0.4s ease;
  }
  .link-box.show { display: block; }

  .link-box input {
    width: 100%;
    padding: 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    margin-top: 12px;
    font-size: 13px;
    background: #fff;
  }

  .link-actions {
    display: flex;
    gap: 10px;
    margin-top: 12px;
  }

  .link-actions button {
    flex: 1;
    padding: 11px 16px;
    font-size: 14px;
    border: none;
    border-radius: 10px;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .link-actions button:hover { transform: translateY(-2px); }

  .btn-copy { background: linear-gradient(135deg, #34d399, #10b981); }
  .btn-share { background: linear-gradient(135deg, #60a5fa, #3b82f6); }

  .hidden { display: none !important; }

  /* ====== КОНВЕРТ ====== */

  .envelope-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 10px 0 5px;
    height: 230px;
    position: relative;
    perspective: 1000px;
  }

  .envelope-closed {
    width: 230px;
    height: 155px;
    background: linear-gradient(135deg, #fcd34d, #f59e0b);
    border-radius: 10px;
    position: relative;
    box-shadow: 0 15px 35px rgba(0,0,0,0.25);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.4s;
    animation: envelopeFloat 3s ease-in-out infinite;
    cursor: pointer;
  }

  @keyframes envelopeFloat {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-10px) rotate(2deg); }
  }

  .envelope-closed:hover {
    transform: translateY(-8px) rotate(0deg) scale(1.04);
  }

  .envelope-closed::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 0; height: 0;
    border-left: 115px solid transparent;
    border-right: 115px solid transparent;
    border-top: 88px solid #fbbf24;
    border-radius: 10px 10px 0 0;
    z-index: 2;
    filter: brightness(0.95);
  }

  .envelope-seal {
    position: absolute;
    top: 58px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 36px;
    z-index: 3;
    filter: drop-shadow(0 3px 6px rgba(0,0,0,0.3));
    animation: sealPulse 2s ease-in-out infinite;
  }
  @keyframes sealPulse {
    0%, 100% { transform: translateX(-50%) scale(1); }
    50% { transform: translateX(-50%) scale(1.12); }
  }

  .envelope-closed .stamp {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 22px;
    z-index: 3;
    opacity: 0.85;
  }

  .envelope-closed .address-line {
    position: absolute;
    bottom: 14px;
    left: 16px;
    right: 16px;
    z-index: 3;
    font-size: 12px;
    color: #92400e;
    font-weight: 600;
    text-align: left;
    font-style: italic;
    opacity: 0.9;
    line-height: 1.4;
  }

  .envelope-closed .address-line .from-name {
    display: block;
    font-size: 14px;
    color: #78350f;
    font-weight: 700;
    font-style: normal;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .envelope-closed.opening {
    animation: envelopeOpen 1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes envelopeOpen {
    0% { transform: translateY(0) rotate(-2deg) scale(1); opacity: 1; }
    30% { transform: translateY(-15px) rotate(0) scale(1.08); opacity: 1; }
    100% { transform: translateY(0) rotate(0) scale(0.8); opacity: 0; }
  }

  .letter-fly {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 260px;
    min-height: 160px;
    background: #fff8e7;
    border: 2px solid #f0c060;
    border-radius: 12px;
    padding: 22px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    transform: translate(-50%, -50%) scale(0.3) rotate(-10deg);
    opacity: 0;
    z-index: 10;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 80px;
  }

  .letter-fly.fly {
    animation: letterFly 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes letterFly {
    0% { transform: translate(-50%, -50%) scale(0.3) rotate(-10deg); opacity: 0; }
    30% { transform: translate(-50%, -50%) scale(1.15) rotate(3deg); opacity: 1; }
    60% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
  }

  #openedMessage { margin-top: 22px; }

  .sender-badge {
    display: inline-block;
    background: linear-gradient(135deg, #fef3c7, #fde68a);
    color: #92400e;
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 16px;
    box-shadow: 0 4px 12px rgba(245,158,11,0.2);
  }
  .sender-badge.anon {
    background: linear-gradient(135deg, #e0e7ff, #c7d2fe);
    color: #3730a3;
  }

  #fullMessage {
    background: #fff8e7;
    border: 2px solid #f0c060;
    border-radius: 14px;
    padding: 28px;
    font-size: 17px;
    color: #333;
    line-height: 1.7;
    text-align: left;
    white-space: pre-wrap;
    word-break: break-word;
    animation: letterReveal 0.8s ease 0.2s both;
    box-shadow: 0 10px 30px rgba(240,192,96,0.25);
  }

  @keyframes letterReveal {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .emoji-big { font-size: 56px; margin-bottom: 15px; animation: pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes pop {
    0% { transform: scale(0); }
    70% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  .buttons-row {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin-top: 25px;
    position: relative;
    min-height: 62px;
    transition: opacity 0.4s;
  }

  #btnYes {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    padding: 15px 28px;
  }

  #btnNo {
    background: linear-gradient(135deg, #f87171 0%, #ef4444 100%);
    position: relative;
    transition: transform 0.12s ease-out;
    padding: 15px 32px;
    border: none;
    border-radius: 12px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    padding: 20px;
    animation: fadeIn 0.25s ease;
  }

  .modal {
    background: #fff;
    border-radius: 22px;
    padding: 38px;
    max-width: 400px;
    width: 100%;
    text-align: center;
    box-shadow: 0 25px 70px rgba(0,0,0,0.4);
    position: relative;
    min-height: 300px;
    animation: cardIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .modal h2 { color: var(--purple); margin-bottom: 12px; font-size: 26px; }
  .modal p { color: #555; margin-bottom: 25px; font-size: 17px; }
  .modal .big-emoji { font-size: 56px; margin-bottom: 12px; display: block; }

  .modal-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    position: relative;
    min-height: 62px;
  }

  #btnModalYes {
    background: linear-gradient(135deg, #34d399, #10b981);
    padding: 15px 24px;
    border: none;
    border-radius: 12px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  #btnModalNo {
    background: linear-gradient(135deg, #f87171, #ef4444);
    padding: 15px 24px;
    border: none;
    border-radius: 12px;
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    position: relative;
    transition: transform 0.12s ease-out;
  }

  .confetti {
    position: fixed;
    width: 10px;
    height: 10px;
    top: -20px;
    z-index: 999;
    pointer-events: none;
    animation: confettiFall linear forwards;
  }
  @keyframes confettiFall {
    to { transform: translateY(105vh) rotate(720deg); opacity: 0; }
  }

  .toast {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(80px);
    background: #333;
    color: #fff;
    padding: 14px 24px;
    border-radius: 12px;
    font-size: 15px;
    opacity: 0;
    transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 2000;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }
  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

  .flying-emoji {
    position: fixed;
    top: -60px;
    font-size: 50px;
    z-index: 999;
    pointer-events: none;
    animation: emojiFall linear forwards;
  }
  @keyframes emojiFall {
    to { transform: translateY(110vh) rotate(360deg); opacity: 0; }
  }

  @keyframes shake {
    0%, 100% { transform: translate(0, 0) rotate(0); }
    20% { transform: translate(-8px, 4px) rotate(-1deg); }
    40% { transform: translate(8px, -4px) rotate(1deg); }
    60% { transform: translate(-6px, -3px) rotate(-0.5deg); }
    80% { transform: translate(6px, 3px) rotate(0.5deg); }
  }
  .shake { animation: shake 0.5s ease-in-out; }

  .kakashka-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    font-size: 130px;
    z-index: 3000;
    pointer-events: none;
    animation: kakashkaPop 2.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    filter: drop-shadow(0 0 30px rgba(139,69,19,0.8));
  }
  @keyframes kakashkaPop {
    0% { transform: translate(-50%, -50%) scale(0) rotate(-180deg); }
    30% { transform: translate(-50%, -50%) scale(1.4) rotate(10deg); }
    50% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
    80% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1.2) rotate(0deg); opacity: 0; }
  }

  .splat {
    position: fixed;
    font-size: 40px;
    z-index: 998;
    pointer-events: none;
    animation: splatAnim 1.5s ease-out forwards;
  }
  @keyframes splatAnim {
    0% { transform: scale(0) rotate(0); opacity: 1; }
    50% { transform: scale(1.5) rotate(180deg); opacity: 0.8; }
    100% { transform: scale(2) rotate(360deg); opacity: 0; }
  }

  body.neon {
    background: #0a0a0a;
    animation: none;
  }
  body.neon .card {
    background: #111;
    color: #0ff;
    box-shadow: 0 0 40px #0ff, 0 0 80px #f0f;
  }
  body.neon h1 { color: #0ff; text-shadow: 0 0 10px #0ff; }
  body.neon p { color: #f0f; }
  body.neon textarea {
    background: #000;
    color: #0ff;
    border-color: #0ff;
  }
  body.neon #fullMessage {
    background: #000;
    color: #0ff;
    border-color: #f0f;
  }
  body.neon .sender-section {
    background: #000;
    border-color: #0ff;
  }

  .secret-btn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: linear-gradient(135deg, #f59e0b, #ec4899);
    border: none;
    font-size: 24px;
    cursor: pointer;
    z-index: 500;
    box-shadow: 0 5px 20px rgba(0,0,0,0.3);
    transition: transform 0.3s;
    padding: 0;
  }
  .secret-btn:hover {
    transform: rotate(180deg) scale(1.15);
  }

  @media (max-width: 480px) {
    .card { padding: 28px 22px; }
    h1 { font-size: 25px; }
    .link-actions { flex-direction: column; }
    .secret-btn { width: 44px; height: 44px; font-size: 20px; }
    .envelope-wrap { height: 185px; }
    .envelope-closed { width: 185px; height: 128px; }
    .envelope-closed::before {
      border-left: 92px solid transparent;
      border-right: 92px solid transparent;
      border-top: 72px solid #fbbf24;
    }
    .letter-fly { width: 220px; }
    .sender-toggle { flex-direction: column; }
  }
</style>
</head>
<body>

<!-- ЭКРАН 1: Создание письма -->
<div class="card" id="createScreen">
  <h1>💌 Напиши письмо</h1>
  <p>Напиши своё послание и отправь ссылку другу</p>

  <textarea id="messageInput" maxlength="1000" placeholder="Дорогой друг, пишу тебе..."></textarea>
  <div class="char-counter" id="charCounter">0 / 1000</div>

  <!-- Блок отправителя -->
  <div class="sender-section">
    <div class="section-label">👤 Кто отправляет?</div>
    <div class="sender-toggle">
      <button type="button" id="btnName" class="active">✍️ Указать имя</button>
      <button type="button" id="btnAnon">🕵️ Анонимно</button>
    </div>
    <input type="text" id="nameInput" maxlength="30" placeholder="Твоё имя (например, Аня)">
    <div class="anon-hint hidden" id="anonHint">🕵️ Получатель не узнает, кто отправил письмо</div>
  </div>

  <button class="main-btn" id="createBtn">✨ Создать ссылку</button>

  <div class="link-box" id="linkBox">
    <div>🔗 Ссылка готова! Отправь её другу:</div>
    <input type="text" id="linkInput" readonly>
    <div class="link-actions">
      <button class="btn-copy" id="copyBtn">📋 Копировать</button>
      <button class="btn-share" id="shareBtn">📤 Поделиться</button>
    </div>
  </div>
</div>

<!-- ЭКРАН 2: Просмотр письма -->
<div class="card hidden" id="letterScreen">
  <h1>Тебе письмо!</h1>
  <p id="letterSubtitle">Кто-то отправил тебе послание. Откроешь?</p>

  <div class="envelope-wrap" id="envelopeWrap">
    <div class="envelope-closed" id="envelopeClosed">
      <div class="stamp">📮</div>
      <div class="envelope-seal">❤️</div>
      <div class="address-line" id="envelopeAddress">Кому: тебе</div>
    </div>
  </div>

  <div class="buttons-row" id="mainButtons">
    <button id="btnYes">Да, открыть</button>
    <button id="btnNo">Нет</button>
  </div>

  <div id="openedMessage" class="hidden">
    <div class="sender-badge" id="senderBadge"></div>
    <div class="emoji-big">💖</div>
    <div id="fullMessage"></div>
  </div>
</div>

<!-- МОДАЛЬНОЕ ОКНО -->
<div class="modal-overlay hidden" id="modal">
  <div class="modal">
    <span class="big-emoji">😢</span>
    <h2>Точно?</h2>
    <p>Ты уверен, что не хочешь открыть письмо?</p>
    <div class="modal-buttons">
      <button id="btnModalYes">Да, точно</button>
      <button id="btnModalNo">Нет, открыть</button>
    </div>
  </div>
</div>

<button class="secret-btn" id="secretBtn" title="Секрет 🤫">🎁</button>
<div class="toast" id="toast"></div>

<script>
// ---------- УТИЛИТЫ ----------

function getDataFromURL() {
  const params = new URLSearchParams(window.location.search);
  const encodedMsg = params.get('msg');
  const encodedName = params.get('from');
  let msg = null, sender = null;
  try {
    if (encodedMsg) msg = decodeURIComponent(escape(atob(encodedMsg)));
    if (encodedName) sender = decodeURIComponent(escape(atob(encodedName)));
  } catch(e) { /* битые данные */ }
  return { msg, sender };
}

function encodeText(text) {
  return btoa(unescape(encodeURIComponent(text)));
}

function showToast(text) {
  const t = document.getElementById('toast');
  t.textContent = text;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(() => t.classList.remove('show'), 2600);
}

function playTone(freq, duration = 0.15, type = 'sine') {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.frequency.value = freq;
    osc.type = type;
    gain.gain.setValueAtTime(0.15, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
    osc.start();
    osc.stop(ctx.currentTime + duration);
  } catch(e) { /* нет поддержки */ }
}

function playSuccess() {
  playTone(523, 0.1);
  setTimeout(() => playTone(659, 0.1), 100);
  setTimeout(() => playTone(784, 0.15), 200);
  setTimeout(() => playTone(1047, 0.25), 320);
}

function playPop() {
  playTone(880, 0.08, 'square');
  setTimeout(() => playTone(1200, 0.1, 'square'), 60);
}

function playFart() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(180, ctx.currentTime);
    osc.frequency.exponentialRampToValueAtTime(60, ctx.currentTime + 0.4);
    gain.gain.setValueAtTime(0.2, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.4);
    osc.start();
    osc.stop(ctx.currentTime + 0.4);
  } catch(e) { /* нет поддержки */ }
}

function launchConfetti(count = 60) {
  const colors = ['#667eea','#764ba2','#ec4899','#10b981','#f59e0b','#f87171'];
  for (let i = 0; i < count; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.background = colors[Math.floor(Math.random() * colors.length)];
    c.style.animationDuration = (2 + Math.random() * 2) + 's';
    c.style.animationDelay = Math.random() * 0.5 + 's';
    c.style.width = c.style.height = (6 + Math.random() * 10) + 'px';
    c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 5000);
  }
}

function addRipple(e) {
  const btn = e.currentTarget;
  const ripple = document.createElement('span');
  ripple.className = 'ripple';
  const rect = btn.getBoundingClientRect();
  const size = Math.max(rect.width, rect.height);
  ripple.style.width = ripple.style.height = size + 'px';
  ripple.style.left = (e.clientX - rect.left - size/2) + 'px';
  ripple.style.top = (e.clientY - rect.top - size/2) + 'px';
  btn.appendChild(ripple);
  setTimeout(() => ripple.remove(), 600);
}

function spawnHearts() {
  const emojis = ['💖','💌','💕','❤️','💗'];
  setInterval(() => {
    const h = document.createElement('div');
    h.className = 'bg-heart';
    h.textContent = emojis[Math.floor(Math.random() * emojis.length)];
    h.style.left = Math.random() * 100 + 'vw';
    h.style.fontSize = (14 + Math.random() * 22) + 'px';
    h.style.animationDuration = (8 + Math.random() * 8) + 's';
    document.body.appendChild(h);
    setTimeout(() => h.remove(), 16000);
  }, 1200);
}
spawnHearts();

function spawnStar() {
  const star = document.createElement('div');
  star.className = 'star';
  star.textContent = ['⭐','✨','🌟','💫'][Math.floor(Math.random() * 4)];
  star.style.left = Math.random() * 100 + 'vw';
  star.style.animationDuration = (3 + Math.random() * 4) + 's';
  document.body.appendChild(star);
  setTimeout(() => star.remove(), 8000);
}
setInterval(spawnStar, 2500);

// ---------- ПАСХАЛКА "МАКСИМ" ----------

let maximTriggered = false;

function triggerMaximEasterEgg() {
  maximTriggered = true;
  document.body.classList.add('shake');
  setTimeout(() => document.body.classList.remove('shake'), 500);
  playFart();
  setTimeout(() => playPop(), 300);

  const emojis = ['💩','💩','💩','🤡','💩','🤡','🎪','💩','💩','🤡'];
  for (let i = 0; i < 30; i++) {
    setTimeout(() => {
      const e = document.createElement('div');
      e.className = 'flying-emoji';
      e.textContent = emojis[Math.floor(Math.random() * emojis.length)];
      e.style.left = Math.random() * 100 + 'vw';
      e.style.fontSize = (40 + Math.random() * 40) + 'px';
      e.style.animationDuration = (2 + Math.random() * 2) + 's';
      document.body.appendChild(e);
      setTimeout(() => e.remove(), 4500);
    }, i * 70);
  }

  const kakashka = document.createElement('div');
  kakashka.className = 'kakashka-popup';
  kakashka.textContent = '💩';
  document.body.appendChild(kakashka);
  setTimeout(() => kakashka.remove(), 2600);

  for (let i = 0; i < 15; i++) {
    setTimeout(() => {
      const s = document.createElement('div');
      s.className = 'splat';
      s.textContent = ['💩','💦','💩'][Math.floor(Math.random() * 3)];
      s.style.left = Math.random() * 100 + 'vw';
      s.style.top = (20 + Math.random() * 60) + 'vh';
      s.style.animationDuration = (1 + Math.random()) + 's';
      document.body.appendChild(s);
      setTimeout(() => s.remove(), 2000);
    }, i * 100);
  }

  launchConfetti(60);
  const jokes = [
    '💩 Максим, это ты? 😂',
    '🤡 Клоуны и какашки прибыли!',
    '💩 Ой, кажется, кто-то написал «Максим»...',
    '🤡 Максим, держись! 💩',
    '💩 Это не Какаши, это КАКАШКИ! 😂'
  ];
  showToast(jokes[Math.floor(Math.random() * jokes.length)]);
  setTimeout(() => { maximTriggered = false; }, 6000);
}

// ---------- ЭКРАН СОЗДАНИЯ ----------

const createScreen = document.getElementById('createScreen');
const letterScreen = document.getElementById('letterScreen');
const messageInput = document.getElementById('messageInput');
const createBtn = document.getElementById('createBtn');
const linkBox = document.getElementById('linkBox');
const linkInput = document.getElementById('linkInput');
const copyBtn = document.getElementById('copyBtn');
const shareBtn = document.getElementById('shareBtn');
const charCounter = document.getElementById('charCounter');

const btnName = document.getElementById('btnName');
const btnAnon = document.getElementById('btnAnon');
const nameInput = document.getElementById('nameInput');
const anonHint = document.getElementById('anonHint');

let isAnonymous = false;

btnName.addEventListener('click', () => {
  isAnonymous = false;
  btnName.classList.add('active');
  btnAnon.classList.remove('active');
  nameInput.disabled = false;
  nameInput.focus();
  anonHint.classList.add('hidden');
  playTone(660, 0.08);
});

btnAnon.addEventListener('click', () => {
  isAnonymous = true;
  btnAnon.classList.add('active');
  btnName.classList.remove('active');
  nameInput.disabled = true;
  nameInput.value = '';
  anonHint.classList.remove('hidden');
  playTone(440, 0.08);
});

messageInput.addEventListener('input', () => {
  const len = messageInput.value.length;
  charCounter.textContent = len + ' / 1000';
  charCounter.classList.toggle('warn', len > 900);

  const text = messageInput.value.toLowerCase();
  if (text.includes('максим') && !maximTriggered) {
    triggerMaximEasterEgg();
  }
});

createBtn.addEventListener('click', addRipple);
createBtn.addEventListener('click', () => {
  const text = messageInput.value.trim();
  if (!text) {
    messageInput.style.borderColor = '#ef4444';
    messageInput.placeholder = 'Напиши хоть что-нибудь! 😊';
    messageInput.focus();
    showToast('✍️ Поле пустое — напиши сообщение');
    playTone(300, 0.2, 'sawtooth');
    return;
  }
  if (text.length > 1000) {
    showToast('😅 Слишком длинно (макс. 1000 символов)');
    return;
  }

  // Имя отправителя
  let senderName = '';
  if (!isAnonymous) {
    senderName = nameInput.value.trim();
    if (!senderName) {
      nameInput.style.borderColor = '#ef4444';
      nameInput.focus();
      showToast('✍️ Укажи имя или выбери «Анонимно»');
      playTone(300, 0.2, 'sawtooth');
      return;
    }
  }

  const encodedMsg = encodeText(text);
  let url = window.location.origin + window.location.pathname + '?msg=' + encodedMsg;
  if (senderName) {
    url += '&from=' + encodeText(senderName);
  }

  linkInput.value = url;
  linkBox.classList.add('show');
  createBtn.disabled = true;
  createBtn.textContent = '✅ Ссылка создана';
  linkBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  launchConfetti(40);
  playSuccess();
  showToast(isAnonymous ? '🕵️ Анонимное письмо готово!' : '🎉 Ссылка готова!');
});

copyBtn.addEventListener('click', addRipple);
copyBtn.addEventListener('click', async () => {
  try {
    await navigator.clipboard.writeText(linkInput.value);
    copyBtn.textContent = '✅ Скопировано!';
    showToast('📋 Ссылка скопирована в буфер обмена');
    playTone(880, 0.1);
    setTimeout(() => copyBtn.textContent = '📋 Копировать', 2000);
  } catch(e) {
    linkInput.select();
    document.execCommand('copy');
    showToast('📋 Скопировано (старый способ)');
  }
});

shareBtn.addEventListener('click', addRipple);
shareBtn.addEventListener('click', async () => {
  const shareData = {
    title: 'Письмо для тебя 💌',
    text: 'Я отправил(а) тебе письмо! Открой 👀',
    url: linkInput.value
  };
  if (navigator.share) {
    try { await navigator.share(shareData); }
    catch(e) { /* отменили */ }
  } else {
    showToast('📤 Скопируй ссылку и отправь вручную');
  }
});

// ---------- ЭКРАН ПИСЬМА ----------

const letterSubtitle = document.getElementById('letterSubtitle');
const envelopeWrap = document.getElementById('envelopeWrap');
const envelopeClosed = document.getElementById('envelopeClosed');
const envelopeAddress = document.getElementById('envelopeAddress');
const senderBadge = document.getElementById('senderBadge');
const fullMessage = document.getElementById('fullMessage');
const openedMessage = document.getElementById('openedMessage');
const mainButtons = document.getElementById('mainButtons');
const btnYes = document.getElementById('btnYes');
const btnNo = document.getElementById('btnNo');

function dodgeButton(btn, event) {
  if (!btn || !event) return;
  if (window.innerWidth < 768) return;

  const btnRect = btn.getBoundingClientRect();
  const mouseX = event.clientX;
  const mouseY = event.clientY;
  const btnCenterX = btnRect.left + btnRect.width / 2;
  const btnCenterY = btnRect.top + btnRect.height / 2;

  let dx = btnCenterX - mouseX;
  let dy = btnCenterY - mouseY;
  const dist = Math.sqrt(dx*dx + dy*dy) || 1;

  const power = Math.min(220, 14000 / dist);
  let newX = dx / dist * power;
  let newY = dy / dist * power;

  const curX = parseFloat(btn.dataset.offsetX || 0);
  const curY = parseFloat(btn.dataset.offsetY || 0);

  const maxOffset = 130;
  let finalX = Math.max(-maxOffset, Math.min(maxOffset, curX + newX));
  let finalY = Math.max(-maxOffset, Math.min(maxOffset, curY + newY));

  btn.dataset.offsetX = finalX;
  btn.dataset.offsetY = finalY;
  btn.style.transform = `translate(${finalX}px, ${finalY}px)`;
}

function resetButton(btn) {
  btn.dataset.offsetX = 0;
  btn.dataset.offsetY = 0;
  btn.style.transform = 'translate(0, 0)';
}

const modal = document.getElementById('modal');
const btnModalYes = document.getElementById('btnModalYes');
const btnModalNo = document.getElementById('btnModalNo');
let noPressedOnce = false;

let letterOpened = false;
let currentMessage = '';
let currentSender = '';

function openLetter() {
  if (letterOpened) return;
  letterOpened = true;

  mainButtons.style.opacity = '0';
  mainButtons.style.pointerEvents = 'none';
  letterSubtitle.style.opacity = '0';

  envelopeClosed.classList.add('opening');
  playTone(523, 0.15);
  setTimeout(() => playTone(784, 0.2), 200);

  setTimeout(() => {
    const fly = document.createElement('div');
    fly.className = 'letter-fly';
    fly.textContent = '💌';
    envelopeWrap.appendChild(fly);
    requestAnimationFrame(() => fly.classList.add('fly'));
    playPop();
  }, 500);

  setTimeout(() => {
    envelopeWrap.style.display = 'none';
    mainButtons.style.display = 'none';
    letterSubtitle.style.display = 'none';

    // Заполняем бейдж отправителя
    if (currentSender) {
      senderBadge.textContent = '✍️ От: ' + currentSender;
      senderBadge.classList.remove('anon');
    } else {
      senderBadge.textContent = '🕵️ Анонимное письмо';
      senderBadge.classList.add('anon');
    }

    openedMessage.classList.remove('hidden');
    fullMessage.textContent = currentMessage;

    launchConfetti(80);
    playSuccess();

    if (currentMessage.toLowerCase().includes('максим')) {
      setTimeout(() => triggerMaximEasterEgg(), 600);
    }
  }, 1600);
}

function initLetterScreen(message, sender) {
  currentMessage = message;
  currentSender = sender || '';

  // На конверте пишем имя отправителя или "Аноним"
  if (currentSender) {
    envelopeAddress.innerHTML = 'Кому: тебе<span class="from-name">От: ' + escapeHtml(currentSender) + '</span>';
  } else {
    envelopeAddress.innerHTML = 'Кому: тебе<span class="from-name">🕵️ От: Аноним</span>';
  }

  // Если имя есть — подзаголовок персонализирован
  if (currentSender) {
    letterSubtitle.textContent = currentSender + ' отправил(а) тебе послание. Откроешь?';
  } else {
    letterSubtitle.textContent = 'Кто-то (анонимно) отправил тебе послание. Откроешь?';
  }

  btnYes.addEventListener('click', addRipple);
  btnYes.addEventListener('click', openLetter);
  envelopeClosed.addEventListener('click', openLetter);

  btnNo.addEventListener('mouseenter', (e) => {
    if (!modal.classList.contains('hidden')) return;
    dodgeButton(btnNo, e);
  });
  btnNo.addEventListener('mousemove', (e) => {
    if (!modal.classList.contains('hidden')) return;
    dodgeButton(btnNo, e);
  });

  btnNo.addEventListener('click', (e) => {
    if (noPressedOnce) return;
    e.preventDefault();
    e.stopPropagation();
    modal.classList.remove('hidden');
    noPressedOnce = true;
    resetButton(btnNo);
    playTone(400, 0.2, 'triangle');
  });

  btnModalYes.addEventListener('click', addRipple);
  btnModalYes.addEventListener('click', () => {
    modal.classList.add('hidden');
    btnNo.style.display = 'none';
    resetButton(btnNo);
    showToast('😌 Мудрое решение! Нажми «Да, открыть»');
    playTone(660, 0.15);
  });

  btnModalNo.addEventListener('mouseenter', (e) => {
    dodgeButton(btnModalNo, e);
  });
  btnModalNo.addEventListener('mousemove', (e) => {
    dodgeButton(btnModalNo, e);
  });

  btnModalNo.addEventListener('click', () => {
    modal.classList.add('hidden');
    btnNo.style.display = 'none';
    openLetter();
  });

  let modalNoHidden = false;
  btnModalNo.addEventListener('mouseenter', () => {
    if (modalNoHidden) return;
    setTimeout(() => {
      if (!modal.classList.contains('hidden')) {
        btnModalNo.style.opacity = '0';
        btnModalNo.style.pointerEvents = 'none';
        modalNoHidden = true;
      }
    }, 450);
  });

  const observer = new MutationObserver(() => {
    if (modal.classList.contains('hidden')) {
      btnModalNo.style.opacity = '1';
      btnModalNo.style.pointerEvents = 'auto';
      resetButton(btnModalNo);
      modalNoHidden = false;
    }
  });
  observer.observe(modal, { attributes: true, attributeFilter: ['class'] });
}

function escapeHtml(str) {
  return str.replace(/[&<>"']/g, (m) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[m]);
}

// ---------- СЕКРЕТНАЯ КНОПКА ----------

const secretBtn = document.getElementById('secretBtn');
let neonMode = false;

secretBtn.addEventListener('click', () => {
  neonMode = !neonMode;
  document.body.classList.toggle('neon', neonMode);
  if (neonMode) {
    showToast('🌃 Неоновый режим включён!');
    playTone(880, 0.1);
    setTimeout(() => playTone(1100, 0.1), 100);
    setTimeout(() => playTone(1320, 0.15), 200);
  } else {
    showToast('☀️ Обычный режим');
    playTone(660, 0.1);
  }
});

let pressTimer;
secretBtn.addEventListener('mousedown', () => {
  pressTimer = setTimeout(() => {
    showToast('🎊 СЮРПРИЗ! Ты нашёл секрет!');
    launchConfetti(200);
    playSuccess();
    for (let i = 0; i < 10; i++) {
      setTimeout(() => {
        const e = document.createElement('div');
        e.className = 'flying-emoji';
        e.textContent = ['🎁','🎉','🎊','💖','⭐'][Math.floor(Math.random() * 5)];
        e.style.left = Math.random() * 100 + 'vw';
        e.style.fontSize = (50 + Math.random() * 30) + 'px';
        e.style.animationDuration = (2 + Math.random() * 2) + 's';
        document.body.appendChild(e);
        setTimeout(() => e.remove(), 4500);
      }, i * 100);
    }
  }, 1500);
});
secretBtn.addEventListener('mouseup', () => clearTimeout(pressTimer));
secretBtn.addEventListener('mouseleave', () => clearTimeout(pressTimer));

// ---------- ЗАПУСК ----------

const { msg: message, sender } = getDataFromURL();

if (message) {
  createScreen.classList.add('hidden');
  letterScreen.classList.remove('hidden');
  initLetterScreen(message, sender);
} else {
  createScreen.classList.remove('hidden');
  letterScreen.classList.add('hidden');
}

let typed = '';
document.addEventListener('keydown', (e) => {
  typed = (typed + e.key).slice(-5).toLowerCase();
  if (typed.includes('love')) {
    launchConfetti(120);
    showToast('💖 Love is in the air!');
    playSuccess();
    typed = '';
  }
  if (typed.includes('konami')) {
    showToast('🎮 Konami code!');
    document.body.classList.add('shake');
    setTimeout(() => document.body.classList.remove('shake'), 500);
    launchConfetti(150);
    typed = '';
  }
});
</script>
</body>
</html>